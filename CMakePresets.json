{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build-${presetName}"
    },
    {
      "name": "cuda",
      "displayName": "CUDA",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_WITH_HIP": "OFF"
      }
    },
    {
      "name": "hip",
      "displayName": "HIP",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_WITH_HIP": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cuda",
      "configurePreset": "cuda"
    },
    {
      "name": "hip",
      "configurePreset": "hip"
    }
  ],
  "testPresets": [
    {
      "name": "cuda",
      "configurePreset": "cuda",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "hip",
      "configurePreset": "hip",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "cuda",
      "displayName": "Configure, build and run the benchmarks (CUDA)",
      "steps": [
        {
          "type": "configure",
          "name": "cuda"
        },
        {
          "type": "build",
          "name": "cuda"
        },
        {
          "type": "test",
          "name": "cuda"
        }
      ]
    },
    {
      "name": "hip",
      "displayName": "Configure, build and run the benchmarks (HIP)",
      "steps": [
        {
          "type": "configure",
          "name": "hip"
        },
        {
          "type": "build",
          "name": "hip"
        },
        {
          "type": "test",
          "name": "hip"
        }
      ]
    }
  ]
}
